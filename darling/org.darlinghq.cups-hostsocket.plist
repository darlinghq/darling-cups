<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Darling does not run its own cupsd. CUPS clients in the prefix use the
	  host's scheduler, whose domain socket is reachable through the host
	  filesystem view at /Volumes/SystemRoot. The client's default server is
	  /private/var/run/cupsd; this job points that path at the host socket on
	  every boot (the container empties /var/run at start, so a link made at
	  install time would not survive). A host without the socket clears the
	  guest link, if present, so no dangling passthrough is left behind.
	-->
	<key>Label</key>
	<string>org.darlinghq.cups-hostsocket</string>
	<key>RunAtLoad</key>
	<true/>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>host=/Volumes/SystemRoot/run/cups/cups.sock; guest=/private/var/run/cupsd; if [ -S &quot;$host&quot; ]; then /bin/ln -sfn &quot;$host&quot; &quot;$guest&quot;; elif [ -L &quot;$guest&quot; ]; then /bin/rm -f &quot;$guest&quot;; fi</string>
	</array>
</dict>
</plist>
